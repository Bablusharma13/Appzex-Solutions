# Base URL of the AppZex API, including the /api prefix.
#   Local development (direct):   http://localhost:5000/api
#   Production with proxy mode:   /api   (and set BACKEND_URL below)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: when set, Next.js proxies /api/* to this backend origin so the
# session cookie is first-party. Example: https://appzex-api.onrender.com
BACKEND_URL=
