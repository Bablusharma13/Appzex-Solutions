# ---------------------------------------------------------------------------
# AppZex backend configuration. Copy to `.env` and adjust.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MySQL connection (docker/docker-compose.yml exposes this locally)
DATABASE_URL="mysql://appzex:appzex_dev_password@localhost:3306/appzex"

# Long random string (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# bcrypt cost factor (10-12 recommended)
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (no wildcards)
CORS_ORIGIN=http://localhost:3000

# Session cookie. Use COOKIE_SECURE=true in production (HTTPS).
# COOKIE_SAMESITE=lax when frontend and API share a site (or when the frontend
# proxies /api), `none` only when they are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway...)
TRUST_PROXY=0

# Private upload directory (outside any public web root)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# AI feature (optional). Leave blank to disable; the UI explains how to enable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=30000

# Support-mode sessions expire automatically after this many minutes
SUPPORT_SESSION_MINUTES=60

# Set to true to run migrations + seed at container start (demo deployments only)
SEED_ON_START=false
